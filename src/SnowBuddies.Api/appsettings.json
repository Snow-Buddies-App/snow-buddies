{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SBConnectionString": "Server=localhost;Database=SnowBuddiesDb;Username=postgres"
  },
  "Jwt": {
    "Issuer": "snow-buddies-api",
    "Audience": "snow-buddies-app",
    "ExpiryMinutes": 60
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Swagger": {
    "Enabled": true
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10
  }
}
